<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="helpdesk_ti.SiteMaster" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - HelpDesk TI</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:bundlereference runat="server" path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <%--Site Scripts--%>
            </Scripts>
        </asp:ScriptManager>

        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <asp:HyperLink ID="lnkBrand" runat="server"
                    CssClass="navbar-brand fw-semibold">HelpDesk TI</asp:HyperLink>
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navbarMenu" title="Mostrar navegación" aria-controls="navbarMenu"
                    aria-expanded="false" aria-label="Mostrar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="navbarMenu" class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto">
                        <asp:PlaceHolder ID="phClienteNav" runat="server">
                            <li class="nav-item">
                                <a class="nav-link" runat="server" href="~/NuevoTicket.aspx">Crear ticket</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" runat="server" href="~/MisTickets.aspx">Mis tickets</a>
                            </li>
                        </asp:PlaceHolder>
                        <asp:PlaceHolder ID="phStaffNav" runat="server">
                            <li class="nav-item">
                                <a class="nav-link" runat="server" href="~/Tickets.aspx">Administrar tickets</a>
                            </li>
                        </asp:PlaceHolder>
                        <asp:PlaceHolder ID="phAdminNav" runat="server">
                            <li class="nav-item">
                                <a class="nav-link" runat="server" href="~/Tecnicos.aspx">Técnicos</a>
                            </li>
                        </asp:PlaceHolder>
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <asp:PlaceHolder ID="phAnonymousNav" runat="server">
                            <li class="nav-item">
                                <a class="nav-link" runat="server" href="~/Login.aspx">Iniciar sesión</a>
                            </li>
                        </asp:PlaceHolder>
                        <asp:PlaceHolder ID="phSignedInNav" runat="server">
                            <li class="nav-item">
                                <span class="navbar-text text-white me-lg-3">
                                    <asp:Label ID="lblNombreUsuario" runat="server" />
                                </span>
                            </li>
                            <li class="nav-item">
                                <asp:LinkButton ID="btnCerrarSesion" runat="server"
                                    CssClass="nav-link" CausesValidation="false"
                                    OnClick="btnCerrarSesion_Click">Cerrar sesión</asp:LinkButton>
                            </li>
                        </asp:PlaceHolder>
                    </ul>
                </div>
            </div>
        </nav>
        <div class="container body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
            <hr />
            <footer>
                <p>&copy; <%: DateTime.Now.Year %> HelpDesk TI</p>
            </footer>
        </div>
    </form>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>
</body>
</html>
